// tsconfig.node.json —— 主进程 / preload / 构建配置
//
// ⚠️ 现状（2026-10-10）：`checkJs` **关着**。迁移期这些文件还是普通 JS，
//   打开会报 222 条 noImplicitAny（实测），而在 JS 里撒 `any` 只是把红灯涂绿 ——
//   所以这一轮不把它当门禁，只把它当作**编辑器的类型来源**（electron / zod 类型仍生效）。
//   P3a 转 TS 时把文件改成 .ts、打开严格检查，并在 package.json 加回 typecheck。
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "composite": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "electron.vite.config.mjs",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "core/**/*"
  ]
}
