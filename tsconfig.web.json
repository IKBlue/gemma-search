// tsconfig.web.json —— 渲染进程（React 落地后与 web 端共用）
// 现状同 tsconfig.node.json：checkJs 关着，只作编辑器的类型来源；P3a 接 TS + React 时打开。
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "composite": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // 同上：渲染层转 .ts/.tsx 后 import 也会带显式扩展名（Vite 与 Node 都要求写清楚）。
    "allowImportingTsExtensions": true,
    "paths": { "@renderer/*": ["./apps/desktop/src/renderer/src/*"] }
  },
  // shared/ipc.ts 是 IPC 契约的唯一来源，渲染层要 import 它的类型（Adapter 的 method: MethodName）。
  // 不列进来会报 TS6307（composite 工程要求被引用的文件在 file list 里）。
  "include": [
    "apps/desktop/src/renderer/src/**/*",
    "apps/desktop/src/shared/**/*",
    "apps/desktop/src/preload/*.d.ts"
  ]
}
