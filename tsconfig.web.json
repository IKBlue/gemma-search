// tsconfig.web.json —— 渲染进程（React 落地后与 web 端共用）
// 现状同 tsconfig.node.json：checkJs 关着，只作编辑器的类型来源；P3a 接 TS + React 时打开。
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "composite": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": { "@renderer/*": ["./apps/desktop/src/renderer/src/*"] }
  },
  "include": ["apps/desktop/src/renderer/src/**/*", "apps/desktop/src/preload/*.d.ts"]
}
