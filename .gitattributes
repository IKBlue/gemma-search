# ============================================================
# gemma-search · .gitattributes
#
# 目的：跨平台一致 + 明确哪些是二进制（避免 git 尝试做行尾转换/文本 diff）
#
# 注：`*.py` / `*.npy` 两条属于**已退役的 Python 档**（2026-10-10 整体删除，
#     见 DEBT-CLEANUP.md §十二）。保留无害（不再有此类文件），故不专门清理。
# ============================================================

# 默认：入库统一 LF，检出时按平台自动
* text=auto eol=lf

# 源码
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows 脚本必须 CRLF（否则某些 cmd 解析会出问题）
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 二进制：不做行尾转换、不做文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.npy   binary
*.npz   binary
*.onnx  binary
*.zip   binary
*.rar   binary
*.7z    binary
*.exe   binary
*.dll   binary
*.node  binary

# 向量转储（spike 证据）：是数据不是文本，标记为二进制避免 diff 爆炸
spike/*.json -diff linguist-generated
# data/quality/ 下的证据**保留文本 diff** —— 它们只有几 KB，
# 而"两次运行之间改了什么"正是需要看得见的东西（曾误加 -diff，git 显示为 Bin，反而看不见）
data/quality/*.json linguist-generated

# 让 GitHub 语言统计不把原型 HTML/CSS 当成主要语言
static/prototype/*.html linguist-documentation
static/prototype/*.css  linguist-documentation
